<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- ===== 标题栏 ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⌨ 手机蓝牙键盘"
                android:textSize="21sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/llmSettingsTopButton"
                style="@style/KeyButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="模型设置" />
        </LinearLayout>

        <!-- ===== 连接状态（紧凑显示，完整管理在二级页面） ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_card"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/headerStatusDot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● "
                android:textSize="15sp"
                android:textColor="@color/disconnected" />

            <TextView
                android:id="@+id/headerStatusText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="未启动"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/disconnected" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="详情见「连接管理」"
                android:textSize="11sp"
                android:textColor="@color/text_hint" />
        </LinearLayout>

        <!-- ===== 文本输入卡片（置顶：输入 + 发送 + 常用语 + 速度滑块） ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="输入文本"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <EditText
                    android:id="@+id/textInput"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:hint="输入文字（支持中文/英文/数字）"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_hint"
                    android:textColorHighlight="#334FC3F7"
                    android:textSize="15sp"
                    android:singleLine="true"
                    android:inputType="text"
                    android:imeOptions="actionSend"
                    android:importantForAutofill="no" />

                <Button
                    android:id="@+id/sendButton"
                    style="@style/PrimaryButton"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="0.45"
                    android:text="发送" />
            </LinearLayout>

            <Button
                android:id="@+id/phraseButton"
                style="@style/KeyButton"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:text="常用语（长按列表项可编辑/删除）" />

            <!-- 输入速度滑块（独占一行，位置直接生效，无需应用按钮） -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="输入速度"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary" />

                <SeekBar
                    android:id="@+id/speedSeekBar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:min="1"
                    android:max="10"
                    android:progress="5"
                    android:progressTint="@color/primary"
                    android:progressBackgroundTint="@color/card_stroke"
                    android:thumbTint="@color/primary" />

                <TextView
                    android:id="@+id/speedValueText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary"
                    android:minWidth="20dp"
                    android:gravity="center" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="滑块位置直接决定输入速度：1=最慢，10=最快（默认 5）。拖动即生效，无需点击“应用”。"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- ===== 中文输入模式卡片（下拉菜单，选中项左侧绿色 √） ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="中文输入模式"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="8dp" />

            <Spinner
                android:id="@+id/unicodeModeSpinner"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_input"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Alt+X（默认）：记事本/Word 等 RichEdit 可用，无需注册表/NumLock；十六进制=Alt+Numpad+（需 EnableHexNumpad+NumLock，记事本无效）；十进制=Alt+0+码点；GBK 仅中文版 Windows。"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- ===== 大模型对话卡片 ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="大模型对话"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />

                <Button
                    android:id="@+id/llmSettingsButton"
                    style="@style/KeyButton"
                    android:text="模型设置" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="选提供方 + 填 Token 后即可对话；「我」的发言为绿色、AI 回复为白色，输出框可直接编辑。"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="8dp" />

            <!-- 提问输入框：4 行，右侧可上下滚动查看长文本（内容溢出时优先内部滚动） -->
            <com.hidble.phonekeyboard.ScrollableEditText
                android:id="@+id/llmInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="110dp"
                android:background="@drawable/bg_input"
                android:padding="12dp"
                android:hint="输入要问模型的话..."
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:textColorHighlight="#334FC3F7"
                android:textSize="14sp"
                android:gravity="top|start"
                android:inputType="textMultiLine"
                android:lines="4"
                android:minLines="4"
                android:scrollbars="vertical"
                android:scrollbarStyle="outsideOverlay"
                android:fadeScrollbars="false"
                android:importantForAutofill="no" />

            <Button
                android:id="@+id/llmSendButton"
                style="@style/PrimaryButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:text="发送给模型" />

            <!-- AI 思考状态（请求中显示，回复后隐藏） -->
            <LinearLayout
                android:id="@+id/llmThinkingRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone"
                android:layout_marginTop="8dp">

                <ProgressBar
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:indeterminateTint="@color/primary" />

                <TextView
                    android:id="@+id/llmThinkingText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AI 正在思考"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <!-- 对话输出框：右侧上下滑块可查看长文本（内容溢出时优先内部滚动） -->
            <com.hidble.phonekeyboard.ScrollableEditText
                android:id="@+id/llmOutput"
                android:layout_width="match_parent"
                android:layout_height="190dp"
                android:background="@drawable/bg_log"
                android:padding="12dp"
                android:hint="对话内容会显示在这里，可直接编辑"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:textSize="13sp"
                android:gravity="top|start"
                android:inputType="textMultiLine"
                android:scrollbars="vertical"
                android:scrollbarStyle="outsideOverlay"
                android:fadeScrollbars="false"
                android:lineSpacingExtra="2dp"
                android:layout_marginTop="8dp"
                android:importantForAutofill="no" />

            <CheckBox
                android:id="@+id/llmIncludeMeCheck"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:buttonTint="@color/check_green"
                android:text="发送到键盘时包含“我”的发言（默认不发送，只发 AI 回复）"
                android:textSize="12sp"
                android:textColor="@color/text_secondary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp">

                <Button
                    android:id="@+id/llmSendToKeyboardButton"
                    style="@style/PrimaryButton"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1.4"
                    android:text="发送到键盘" />

                <Button
                    android:id="@+id/llmClearButton"
                    style="@style/KeyButton"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="0.6"
                    android:layout_marginStart="8dp"
                    android:text="清空" />
            </LinearLayout>
        </LinearLayout>

        <!-- ===== 二级菜单入口卡片 ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="更多功能"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="光标控制、组合键、功能键、蓝牙开关与已配对设备、命令日志已收纳到二级页面，让主界面更清爽。"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/connectionButton"
                    style="@style/KeyButton"
                    android:layout_weight="1"
                    android:text="连接管理" />

                <Button
                    android:id="@+id/keysButton"
                    style="@style/KeyButton"
                    android:layout_weight="1"
                    android:text="更多按键" />

                <Button
                    android:id="@+id/logButton"
                    style="@style/KeyButton"
                    android:layout_weight="1"
                    android:text="命令日志" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
