<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 标题 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="BLE HID 键盘"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <!-- 连接状态区域 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="状态: "
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="未连接"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/disconnected" />
            </LinearLayout>

            <TextView
                android:id="@+id/deviceNameText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="请扫描并连接设备"
                android:textSize="14sp"
                android:textColor="#666666"
                android:layout_marginBottom="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/scanButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="扫描设备"
                    android:layout_marginEnd="8dp" />

                <Button
                    android:id="@+id/disconnectButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="断开连接"
                    android:enabled="false" />
            </LinearLayout>
        </LinearLayout>

        <!-- 文本输入区域 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="输入文本"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/textInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="在此输入文字..."
                android:inputType="text"
                android:enabled="false"
                android:minLines="3"
                android:gravity="top"
                android:layout_marginBottom="8dp"
                android:padding="12dp"
                android:background="@drawable/edit_background" />

            <Button
                android:id="@+id/sendButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="发送"
                android:enabled="false" />
        </LinearLayout>

        <!-- 功能键区域 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="功能键"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <Button
                    android:id="@+id/btnEnter"
                    style="@style/KeyButton"
                    android:text="Enter"
                    android:layout_weight="1" />

                <Button
                    android:id="@+id/btnBackspace"
                    style="@style/KeyButton"
                    android:text="Back"
                    android:layout_weight="1" />

                <Button
                    android:id="@+id/btnTab"
                    style="@style/KeyButton"
                    android:text="Tab"
                    android:layout_weight="1" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnEscape"
                    style="@style/KeyButton"
                    android:text="Esc"
                    android:layout_weight="1" />

                <Button
                    android:id="@+id/btnDelete"
                    style="@style/KeyButton"
                    android:text="Del"
                    android:layout_weight="1" />
            </LinearLayout>
        </LinearLayout>

        <!-- 光标控制区域 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="光标控制"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <!-- 方向键 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="8dp">

                <Button
                    android:id="@+id/btnUp"
                    style="@style/KeyButton"
                    android:text="↑"
                    android:layout_marginEnd="8dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="8dp">

                <Button
                    android:id="@+id/btnLeft"
                    style="@style/KeyButton"
                    android:text="←"
                    android:layout_marginEnd="8dp" />

                <Button
                    android:id="@+id/btnDown"
                    style="@style/KeyButton"
                    android:text="↓"
                    android:layout_marginEnd="8dp" />

                <Button
                    android:id="@+id/btnRight"
                    style="@style/KeyButton"
                    android:text="→" />
            </LinearLayout>

            <!-- Home/End -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnHome"
                    style="@style/KeyButton"
                    android:text="Home"
                    android:layout_weight="1" />

                <Button
                    android:id="@+id/btnEnd"
                    style="@style/KeyButton"
                    android:text="End"
                    android:layout_weight="1" />
            </LinearLayout>
        </LinearLayout>

        <!-- 组合键区域 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="组合键"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <Button
                    android:id="@+id/btnCtrlC"
                    style="@style/KeyButton"
                    android:text="Ctrl+C"
                    android:layout_weight="1" />

                <Button
                    android:id="@+id/btnCtrlV"
                    style="@style/KeyButton"
                    android:text="Ctrl+V"
                    android:layout_weight="1" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <Button
                    android:id="@+id/btnCtrlX"
                    style="@style/KeyButton"
                    android:text="Ctrl+X"
                    android:layout_weight="1" />

                <Button
                    android:id="@+id/btnCtrlA"
                    style="@style/KeyButton"
                    android:text="Ctrl+A"
                    android:layout_weight="1" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnCtrlZ"
                    style="@style/KeyButton"
                    android:text="Ctrl+Z"
                    android:layout_weight="1" />

                <Button
                    android:id="@+id/btnCtrlS"
                    style="@style/KeyButton"
                    android:text="Ctrl+S"
                    android:layout_weight="1" />
            </LinearLayout>
        </LinearLayout>

        <!-- 命令日志区域 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="16dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="命令日志"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="150dp">

                <TextView
                    android:id="@+id/commandLog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="等待连接..."
                    android:textSize="12sp"
                    android:fontFamily="monospace"
                    android:background="#f5f5f5"
                    android:padding="8dp" />
            </ScrollView>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
