<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="58dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="14dp">

        <Button
            android:id="@+id/backButton"
            style="@style/KeyButton"
            android:layout_width="46dp"
            android:layout_height="42dp"
            android:text="‹"
            android:textSize="24sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="键盘与模型设置"
                android:textColor="@color/text_primary"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="一个 App · 手动选择输出终端"
                android:textColor="@color/text_secondary"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="15dp"
            android:paddingEnd="15dp"
            android:paddingBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_hero"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <TextView
                    android:layout_width="46dp"
                    android:layout_height="46dp"
                    android:background="@drawable/bg_avatar"
                    android:gravity="center"
                    android:text="⌨"
                    android:textColor="@color/clinical_teal"
                    android:textSize="20sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="统一输出中心"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="终端源码已打包，选择即可切换；不再安装多个键盘 App。"
                        android:textColor="@color/text_secondary"
                        android:textSize="10sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="15dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="输出终端"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="选择本次病例要使用的终端"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp" />

                <LinearLayout
                    android:id="@+id/connectionIndicator"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_record"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="11dp">

                    <TextView
                        android:id="@+id/outputIndicatorDot"
                        android:layout_width="20dp"
                        android:layout_height="wrap_content"
                        android:text="●"
                        android:textColor="@color/disconnected"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/outputIndicatorTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="请选择输出设备"
                            android:textColor="@color/text_primary"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/outputIndicatorDetail"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="选择后会在这里显示终端连接状态"
                            android:textColor="@color/text_secondary"
                            android:textSize="9sp" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/connectButton"
                        style="@style/KeyButton"
                        android:layout_width="76dp"
                        android:layout_height="36dp"
                        android:text="连接"
                        android:textSize="10sp" />
                </LinearLayout>

                <RadioGroup
                    android:id="@+id/terminalGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/terminalPhone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/clinical_teal"
                        android:paddingTop="7dp"
                        android:paddingBottom="7dp"
                        android:text="手机蓝牙 HID\n手机直接作为标准蓝牙键盘"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />

                    <RadioButton
                        android:id="@+id/terminalPico"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/clinical_teal"
                        android:paddingTop="7dp"
                        android:paddingBottom="7dp"
                        android:text="Pico W\nBLE 数据通道 → USB HID"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />

                    <RadioButton
                        android:id="@+id/terminalEsp32"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/clinical_teal"
                        android:paddingTop="7dp"
                        android:paddingBottom="7dp"
                        android:text="ESP32-S3 Super Mini\nBLE 桥接 → USB HID"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />

                    <RadioButton
                        android:id="@+id/terminalYdEsp32"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/clinical_teal"
                        android:paddingTop="7dp"
                        android:paddingBottom="7dp"
                        android:text="YD-ESP32-S3 N16R8\nN16R8 双 Type-C 桥接板"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />

                    <RadioButton
                        android:id="@+id/terminalEsp32Legacy"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:buttonTint="@color/clinical_warning"
                        android:paddingTop="7dp"
                        android:paddingBottom="7dp"
                        android:text="ESP32-S3 旧 BLE HID（兼容归档）\n保留旧固件连接能力"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp" />
                </RadioGroup>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="11dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="15dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="终端连接"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/connectionState"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="未连接"
                            android:textColor="@color/clinical_warning"
                            android:textSize="10sp" />
                    </LinearLayout>

                </LinearLayout>

                <TextView
                    android:id="@+id/connectionHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="手机蓝牙终端请在当前键盘工具页启动后连接电脑。"
                    android:textColor="@color/text_secondary"
                    android:textSize="9.5sp" />

                <ListView
                    android:id="@+id/deviceList"
                    android:layout_width="match_parent"
                    android:layout_height="130dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_list"
                    android:divider="@color/card_stroke"
                    android:dividerHeight="1dp"
                    android:padding="3dp"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="11dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="15dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="输出参数"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="速度"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />

                    <SeekBar
                        android:id="@+id/speedSeekBar"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_marginEnd="10dp"
                        android:layout_weight="1"
                        android:max="10"
                        android:min="1"
                        android:progress="5"
                        android:progressBackgroundTint="@color/card_stroke"
                        android:progressTint="@color/clinical_teal"
                        android:thumbTint="@color/clinical_teal" />

                    <TextView
                        android:id="@+id/speedValue"
                        android:layout_width="28dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="5"
                        android:textColor="@color/clinical_teal"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="中文输出模式"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="所有档位较上一版再提升约 10%；第 8 档为稳定上限，第 9、10 档继续突破保护下限。出现丢字时请手动降低一档。"
                    android:textColor="@color/clinical_warning"
                    android:textSize="9sp" />

                <Spinner
                    android:id="@+id/unicodeModeSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/bg_input"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="11dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="15dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="大模型"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="当前仅提供 DeepSeek 和小米 MiMo"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp" />

                <Spinner
                    android:id="@+id/modelProviderSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_input"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp" />

                <TextView
                    android:id="@+id/modelName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="模型：deepseek-v4-flash"
                    android:textColor="@color/text_secondary"
                    android:textSize="9.5sp" />

                <EditText
                    android:id="@+id/apiTokenInput"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="9dp"
                    android:background="@drawable/bg_input"
                    android:hint="API Token"
                    android:inputType="textPassword"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_hint"
                    android:textSize="12sp" />

                <CheckBox
                    android:id="@+id/showTokenCheck"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:buttonTint="@color/clinical_teal"
                    android:text="显示 API Token"
                    android:textColor="@color/text_secondary"
                    android:textSize="10sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/testModelButton"
                        style="@style/KeyButton"
                        android:layout_width="118dp"
                        android:layout_height="42dp"
                        android:text="测试模型连接"
                        android:textSize="10sp" />

                    <TextView
                        android:id="@+id/modelTestState"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:text="未测试"
                        android:textColor="@color/text_secondary"
                        android:textSize="9.5sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Token 仅保存在本机设置中；正式临床使用前应改为系统加密存储。"
                    android:textColor="@color/text_hint"
                    android:textSize="9sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/saveButton"
        style="@style/PrimaryButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginStart="15dp"
        android:layout_marginTop="7dp"
        android:layout_marginEnd="15dp"
        android:layout_marginBottom="12dp"
        android:text="保存全部设置" />
</LinearLayout>
