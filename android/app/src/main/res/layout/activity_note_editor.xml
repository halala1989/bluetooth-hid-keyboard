<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="14dp">

        <Button
            android:id="@+id/backButton"
            style="@style/KeyButton"
            android:layout_width="46dp"
            android:layout_height="42dp"
            android:text="‹"
            android:textSize="24sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="病例书写"
            android:textColor="@color/text_primary"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/connectionChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_warning_chip"
            android:paddingStart="10dp"
            android:paddingTop="5dp"
            android:paddingEnd="10dp"
            android:paddingBottom="5dp"
            android:text="输出未连接"
            android:textColor="@color/clinical_warning"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingBottom="22dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_hero"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <TextView
                    android:id="@+id/patientAvatar"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_avatar"
                    android:gravity="center"
                    android:text="患"
                    android:textColor="@color/clinical_teal"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="11dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/patientName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="患者姓名"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/patientMeta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="内科一病区 · 08床 · 入院诊断"
                        android:textColor="#9DB9BE"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/FormLabel"
                android:layout_marginTop="18dp"
                android:text="文书类型" />

            <Spinner
                android:id="@+id/recordTypeSpinner"
                style="@style/FormSpinner" />

            <TextView
                style="@style/FormLabel"
                android:layout_marginTop="12dp"
                android:text="文书标题" />

            <EditText
                android:id="@+id/recordTitleInput"
                style="@style/FormInput"
                android:hint="例如：2026-11-08 日常病程记录"
                android:inputType="text"
                android:maxLines="1" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="快速模板"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/templateBasicButton"
                        style="@style/KeyButton"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:minWidth="104dp"
                        android:text="病程骨架" />

                    <Button
                        android:id="@+id/templateSoapButton"
                        style="@style/KeyButton"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:minWidth="92dp"
                        android:text="SOAP" />

                    <Button
                        android:id="@+id/templateDischargeButton"
                        style="@style/KeyButton"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:minWidth="104dp"
                        android:text="出院小结" />
                </LinearLayout>
            </HorizontalScrollView>

            <EditText
                android:id="@+id/contentInput"
                android:layout_width="match_parent"
                android:layout_height="360dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_input"
                android:gravity="top|start"
                android:hint="在此书写病例内容……"
                android:inputType="textMultiLine"
                android:padding="14dp"
                android:scrollbarStyle="outsideOverlay"
                android:scrollbars="vertical"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_hint"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/characterCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="end"
                android:text="0 字"
                android:textColor="@color/text_hint"
                android:textSize="10sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="隐私提示：本页内容仅保存在本机加密数据库中；点击“发送到电脑”后才会通过蓝牙键盘输出。"
                android:textColor="@color/text_hint"
                android:textSize="10sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/saveDraftButton"
                    style="@style/SecondaryButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="保存草稿" />

                <Button
                    android:id="@+id/sendToComputerButton"
                    style="@style/PrimaryButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1.4"
                    android:text="发送到电脑" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
