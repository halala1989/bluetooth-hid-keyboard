# YD-ESP32-S3 (silk-screen YD-ESP32-23-2022-V1.3) · ESP32-S3-WROOM-1 N16R8
# 16 MB QIO Flash + 8 MB OPI PSRAM. These values override sdkconfig.defaults.

# 16 MB Flash / QIO 80 MHz
# CONFIG_ESPTOOLPY_FLASHSIZE_4MB is not set
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# 8 MB Octal PSRAM / 80 MHz
# CONFIG_SPIRAM_MODE_QUAD is not set
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_TYPE_ESPPSRAM64=y
CONFIG_SPIRAM_SPEED_80M=y

# 1.5 MB factory app, no OTA. The bridge firmware is well within this size.
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
